{
  "name": "breeze-tauri",
  "version": "3.6.1",
  "private": true,
  "description": "Breeze Desktop (Tauri \u2014 lightweight Rust binary)",
  "scripts": {
    "dev": "cargo tauri dev",
    "build": "cargo tauri build",
    "build:debug": "cargo tauri build --debug",
    "build:win": "cargo tauri build --target x86_64-pc-windows-msvc",
    "build:mac": "cargo tauri build --target universal-apple-darwin",
    "build:linux": "cargo tauri build --target x86_64-unknown-linux-gnu"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shizukutanaka/Breeze.git"
  },
  "homepage": "https://breeze.pages.dev",
  "bugs": "https://github.com/shizukutanaka/Breeze/issues"
}
